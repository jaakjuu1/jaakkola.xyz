---
import HintPage from '../components/HintPage.astro';
import PasswordForm from '../components/PasswordForm';
import MainLayout from '../layouts/MainLayout.astro';
import { hintSets } from '../config/hints';

// Get the tokens from the request
const accessToken = Astro.cookies.get('hint_access')?.value;
const currentHintId = Astro.cookies.get('current_hint')?.value;
const hintSetId = Astro.cookies.get('hint_set_id')?.value;

// Get the current hint set and hint
const currentSet = hintSetId ? hintSets[hintSetId] : null;
const currentHint = currentSet && currentHintId ? currentSet.hints[currentHintId] : null;
const isLastHint = currentHint ? !currentHint.nextHintId : false;

// Check if we should show the welcome screen
const showWelcome = !accessToken || !currentHintId || !currentSet || !currentHint;
---

<MainLayout title="Arvoitusseikkailu" description="Tervetuloa arvoitusseikkailuun!">
    {showWelcome ? (
        <div class="flex flex-col items-center justify-center min-h-screen py-12 px-4">
            <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-lg">
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-gray-900 mb-4">
                        Tervetuloa arvoitusseikkailuun!
                    </h1>
                    <p class="text-gray-600 mb-8">
                        Syötä salasana aloittaaksesi seikkailun.
                    </p>
                </div>
                <PasswordForm client:load />
            </div>
        </div>
    ) : (
        <div class="flex flex-col items-center justify-center min-h-screen py-12 px-4">
            <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-lg">
                <div class="text-center">
                    <h1 class="text-3xl font-bold text-gray-900 mb-4">
                        {currentHint.title}
                    </h1>
                    <p class="text-xl text-gray-600 mb-8">
                        {currentHint.description}
                    </p>
                </div>
                
                <div class="prose prose-lg">
                    <p class="text-gray-800">
                        Tässä arvoituksesi:
                    </p>
                    <blockquote class="italic text-gray-700 border-l-4 border-blue-500 pl-4 my-4">
                        {currentHint.riddle}
                    </blockquote>
                    
                    <div class="mt-8">
                        <PasswordForm 
                            client:load 
                            currentHintId={currentHintId} 
                            hintSetId={hintSetId}
                            isFinal={isLastHint}
                        />
                    </div>
                </div>
            </div>
        </div>
    )}
</MainLayout>